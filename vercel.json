{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "admin/**", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/warehouse", "destination": "/admin/warehouse.html" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
